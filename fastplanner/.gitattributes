# Auto detect text files and perform LF normalization
* text=auto

# C++ files
*.cpp text diff=cpp
*.hpp text diff=cpp
*.h text diff=cpp
*.c text diff=cpp

# CMake files
CMakeLists.txt text
*.cmake text

# Documentation
*.md text
*.txt text

# Scripts
*.sh text eol=lf
*.py text eol=lf

# Binary files
*.so binary
*.a binary
*.o binary
*.dylib binary
*.lib binary
*.dll binary
*.exe binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary

